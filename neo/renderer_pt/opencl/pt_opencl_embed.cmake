# Concatenates the OpenCL program sources into one NUL terminated char array.
#
#   cmake -DOUTPUT=<header> -DINPUTS=<file|file|...> -P pt_opencl_embed.cmake
#
# Local #include "renderer_pt/..." lines are dropped (the files are already
# concatenated in dependency order) and every file starts with a #line marker
# so OpenCL build logs point at the original file and line. A byte array is
# used instead of a string literal because MSVC limits literal length.

string(REPLACE "|" ";" INPUTS "${INPUTS}")
if(NOT OUTPUT OR NOT INPUTS)
	message(FATAL_ERROR "pt_opencl_embed.cmake needs OUTPUT and INPUTS")
endif()

set(program "")
foreach(input ${INPUTS})
	get_filename_component(name "${input}" NAME)
	file(READ "${input}" text)
	string(REGEX REPLACE "#include[ \t]+\"renderer_pt/[^\"]*\"" "/* include removed by pt_opencl_embed.cmake */" text "${text}")
	string(APPEND program "#line 1 \"${name}\"\n${text}\n")
endforeach()

set(staging "${OUTPUT}.cl")
file(WRITE "${staging}" "${program}")
file(READ "${staging}" hex HEX)
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n" bytes "${bytes}")

set(header "/* generated by pt_opencl_embed.cmake, do not edit */\n")
string(APPEND header "static const char ptOpenCLProgram[] = {\n${bytes}0x00\n};\n")

# only touch the header when the content changed, so dependents do not rebuild
set(previous "")
if(EXISTS "${OUTPUT}")
	file(READ "${OUTPUT}" previous)
endif()
if(NOT previous STREQUAL header)
	file(WRITE "${OUTPUT}" "${header}")
endif()
